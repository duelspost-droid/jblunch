# 로컬 실행 시 필요한 환경변수
# 이 파일을 .env.local로 복사하고 값을 채워주세요
# cp .env.example .env.local

# Anthropic API 키 (https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=sk-ant-api03-...

# Gmail 발신 계정
GMAIL_USER=your@gmail.com

# Gmail App Password (https://myaccount.google.com/apppasswords)
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Kakao Local API (선택, 기본값 내장)
KAKAO_REST_API_KEY=af04c6cff1c0c408283c25e84d5b481d

# Naver Local API (선택, 지도 정확도 향상)
# https://www.ncloud.com에서 발급
NAVER_CLIENT_ID=your_naver_client_id
NAVER_CLIENT_SECRET=your_naver_client_secret
